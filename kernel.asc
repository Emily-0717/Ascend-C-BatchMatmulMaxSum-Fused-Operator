#include <cmath>
#include <cstdint>
#include <stdexcept>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"

// Revision r5: exactly one kernel launch per run_kernel invocation.
// The includer defines TensorInfo and TensorGroupInfo.
// No main(), include guards, or pragma once.
// Requires host linkage to tiling_api and platform.
// IMPORTANT: This draft has not been compiled or run on an Ascend device.
// The wrapper deliberately synchronizes before releasing its workspace.

namespace bmms_detail {
constexpr int32_t TILE_M = 16;
constexpr int32_t TILE_N = 128;
constexpr int32_t NZ_WIDTH = 16; // Default FP32 Matmul NZ, ChannelSplit disabled.
constexpr int32_t PARTIAL_STRIDE = 8; // Each writer owns a full 32-byte DMA block.
constexpr uint16_t REDUCE_FLAG = 8; // Matmul uses 0/1; SyncAll reserves 11..14.

struct LaunchInfo {
    AscendC::tiling::TCubeTiling cube;
    int32_t batch;
    int32_t m;
    int32_t n;
    int32_t k;
    int32_t mTiles;
    int32_t nTile;
    int32_t workers;
};

template<AscendC::HardEvent EVENT>
__aicore__ inline void Sync()
{
    const int32_t id = ::GetTPipePtr()->FetchEventID(EVENT);
    AscendC::SetFlag<EVENT>(id);
    AscendC::WaitFlag<EVENT>(id);
}

__aicore__ inline void KahanAdd(float value, float &sum, float &correction)
{
    const float adjusted = value - correction;
    const float next = sum + adjusted;
    correction = (next - sum) - adjusted;
    sum = next;
}

template<typename T, bool TA, bool TB>
class FusedKernel {
public:
    using AType = AscendC::MatmulType<AscendC::TPosition::GM,
        ::CubeFormat::ND, T, TA>;
    using BType = AscendC::MatmulType<AscendC::TPosition::GM,
        ::CubeFormat::ND, T, TB>;
    using CType = AscendC::MatmulType<AscendC::TPosition::VECIN,
        ::CubeFormat::NZ, float>;
    using BiasType = AscendC::MatmulType<AscendC::TPosition::GM,
        ::CubeFormat::ND, float>;

    AscendC::Matmul<AType, BType, CType, BiasType> mm;

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR partial, GM_ADDR y,
                               const LaunchInfo &info, AscendC::TPipe *pipe)
    {
        cfg = info;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1));
        b.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2));
        p.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partial));
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y));
        // REGIST_MATMUL_OBJ must precede these allocations.
        pipe->InitBuffer(cQueue, 1, TILE_M * cfg.nTile * sizeof(float));
        pipe->InitBuffer(maxBuffer, TILE_M * NZ_WIDTH * sizeof(float));
        // Each single-repeat WholeReduceMax output gets an aligned slot.
        pipe->InitBuffer(rowBuffer, TILE_M * 8 * sizeof(float));
        pipe->InitBuffer(outQueue, 1, PARTIAL_STRIDE * sizeof(float));
        if (cfg.mTiles > 1) {
            pipe->InitBuffer(sumQueue, 1,
                cfg.mTiles * PARTIAL_STRIDE * sizeof(float));
        }
    }

    __aicore__ inline void Process()
    {
        auto lanes = maxBuffer.Get<float>();
        auto rowResults = rowBuffer.Get<float>();
        const int64_t count = static_cast<int64_t>(cfg.batch) * cfg.mTiles;
        const float negativeInfinity = -INFINITY;

        for (int64_t task = AscendC::GetBlockIdx(); task < count;
             task += cfg.workers) {
            const int32_t batch = static_cast<int32_t>(task / cfg.mTiles);
            const int32_t m0 = static_cast<int32_t>(task % cfg.mTiles) * TILE_M;
            const int32_t rows = cfg.m - m0 < TILE_M ? cfg.m - m0 : TILE_M;
            const int64_t aBase = static_cast<int64_t>(batch) * cfg.m * cfg.k;
            const int64_t bBase = static_cast<int64_t>(batch) * cfg.k * cfg.n;
            // TA storage [B,K,M]; otherwise [B,M,K].
            const int64_t aOffset = aBase + (TA ? m0 : static_cast<int64_t>(m0) * cfg.k);

            AscendC::Duplicate(lanes, negativeInfinity, TILE_M * NZ_WIDTH);
            AscendC::PipeBarrier<PIPE_V>();

            for (int32_t n0 = 0; n0 < cfg.n; n0 += cfg.nTile) {
                const int32_t cols = cfg.n - n0 < cfg.nTile ? cfg.n - n0 : cfg.nTile;
                // TB storage [B,N,K]; otherwise [B,K,N].
                const int64_t bOffset = bBase + (TB ? static_cast<int64_t>(n0) * cfg.k : n0);
                mm.SetTensorA(a[aOffset], TA);
                mm.SetTensorB(b[bOffset], TB);
                mm.SetSingleShape(rows, cols, cfg.k);

                // One baseM x baseN tile. Matmul accumulates the entire K
                // dimension in FP32 before returning C; never Max a K fragment.
                while (mm.template Iterate<true>()) {
                    auto c = cQueue.AllocTensor<float>();
                    mm.template GetTensorC<true>(c, 0, true);
                    cQueue.EnQue(c);
                    c = cQueue.DeQue<float>();

                    const int32_t nBlocks = (cols + NZ_WIDTH - 1) / NZ_WIDTH;
                    const int32_t tail = cols % NZ_WIDTH;
                    if (tail != 0) {
                        // Cube padding is zero; zero MUST NOT enter MaxSim.
                        // Sequential NZ layout: [N/16, baseM, 16].
                        const int32_t last = (nBlocks - 1) * TILE_M * NZ_WIDTH;
                        for (int32_t r = 0; r < rows; ++r) {
                            for (int32_t j = tail; j < NZ_WIDTH; ++j) {
                                c.SetValue(last + r * NZ_WIDTH + j, negativeInfinity);
                            }
                        }
                        Sync<AscendC::HardEvent::S_V>();
                    }

                    // Keep 16 lane maxima per row across all N blocks.
                    // Padded M rows are ignored in the subsequent Sum.
                    for (int32_t nb = 0; nb < nBlocks; ++nb) {
                        AscendC::Max(lanes, lanes,
                            c[nb * TILE_M * NZ_WIDTH], TILE_M * NZ_WIDTH);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                    // Finish reading C before its UB storage is reused.
                    Sync<AscendC::HardEvent::V_MTE2>();
                    cQueue.FreeTensor(c);
                }
                mm.End();
            }

            // A row's maximum is max over its 16 lane maxima.
            for (int32_t r = 0; r < rows; ++r) {
                AscendC::WholeReduceMax(rowResults[r * 8], lanes[r * NZ_WIDTH],
                    NZ_WIDTH, 1, 1, 1, 2);
            }
            Sync<AscendC::HardEvent::V_S>();
            float sum = 0.0f;
            float correction = 0.0f;
            for (int32_t r = 0; r < rows; ++r) {
                KahanAdd(rowResults.GetValue(r * 8), sum, correction);
            }

            auto out = outQueue.AllocTensor<float>();
            out.SetValue(0, sum);
            Sync<AscendC::HardEvent::S_MTE3>();
            outQueue.EnQue(out);
            out = outQueue.DeQue<float>();
            if (cfg.mTiles == 1) {
                // With at most 16 M rows, this task owns a complete batch.
                // Write exactly one FP32 value.
                AscendC::DataCopyExtParams copy = {1, sizeof(float), 0, 0, 0};
                AscendC::DataCopyPad(output[batch], out, copy);
            } else {
                // Each partial writer owns an independent aligned DMA block.
                AscendC::DataCopy(p[task * PARTIAL_STRIDE], out, PARTIAL_STRIDE);
            }
            outQueue.FreeTensor(out);
        }

        if (cfg.mTiles > 1) {
            // Every launched AIV participates, including AIVs with no task.
            // Mode 0 synchronizes AIVs only. Wait for all partial GM writes
            // before any AIV reads another AIV's partial. AICs remain in the
            // Matmul message server and must not be included in this barrier.
            AscendC::CrossCoreSetFlag<0, PIPE_MTE3>(REDUCE_FLAG);
            AscendC::CrossCoreWaitFlag<0>(REDUCE_FLAG);

            const int32_t length = cfg.mTiles * PARTIAL_STRIDE;
            for (int32_t batch = AscendC::GetBlockIdx(); batch < cfg.batch;
                 batch += cfg.workers) {
                auto input = sumQueue.AllocTensor<float>();
                AscendC::DataCopy(input,
                    p[static_cast<int64_t>(batch) * length], length);
                sumQueue.EnQue(input);
                input = sumQueue.DeQue<float>();
                Sync<AscendC::HardEvent::MTE2_S>();

                float sum = 0.0f;
                float correction = 0.0f;
                // Fixed M-tile order; no floating-point atomic additions.
                for (int32_t t = 0; t < cfg.mTiles; ++t) {
                    KahanAdd(input.GetValue(t * PARTIAL_STRIDE), sum, correction);
                }
                sumQueue.FreeTensor(input);

                auto out = outQueue.AllocTensor<float>();
                out.SetValue(0, sum);
                Sync<AscendC::HardEvent::S_MTE3>();
                outQueue.EnQue(out);
                out = outQueue.DeQue<float>();
                AscendC::DataCopyExtParams copy = {1, sizeof(float), 0, 0, 0};
                AscendC::DataCopyPad(output[batch], out, copy);
                outQueue.FreeTensor(out);
            }
        }
    }

private:
    LaunchInfo cfg;
    AscendC::GlobalTensor<T> a, b;
    AscendC::GlobalTensor<float> p, output;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> cQueue;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> sumQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outQueue;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> maxBuffer, rowBuffer;
};

inline void CheckAcl(aclError error)
{
    if (error != ACL_SUCCESS) {
        throw std::runtime_error("BatchMatmulMaxSum: ACL runtime failure");
    }
}

// A correctness-first owner. No result/input caching; no dangling async buffers.
struct WorkspaceOwner {
    void *address = nullptr;
    aclrtStream stream;
    explicit WorkspaceOwner(aclrtStream s) : stream(s) {}
    ~WorkspaceOwner()
    {
        if (address != nullptr) {
            // Also protects lifetime if a launch/check throws.
            aclrtSynchronizeStream(stream);
            aclrtFree(address);
        }
    }
};
} // namespace bmms_detail

template<typename T, bool TA, bool TB>
__schedmode__(1) __global__ __mix__(1, 2) void batch_matmul_max_sum_custom(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR partial, GM_ADDR y,
    __kfc_workspace__ GM_ADDR systemWorkspace,
    bmms_detail::LaunchInfo info)
{
    AscendC::TPipe pipe;
    bmms_detail::FusedKernel<T, TA, TB> op;
    // ASC initializes this pointer from the __kfc_workspace__ parameter.
    REGIST_MATMUL_OBJ(&pipe, ::GetSysWorkSpacePtr(), op.mm, &info.cube);
    op.Init(x1, x2, partial, y, info, &pipe);
    op.Process();
}

namespace bmms_detail {
template<typename T>
inline void Launch(GM_ADDR x1, GM_ADDR x2, GM_ADDR partial, GM_ADDR y, GM_ADDR system,
                   const LaunchInfo &info, uint32_t blocks, aclrtStream stream,
                   bool ta, bool tb)
{
    if (ta && tb) {
        batch_matmul_max_sum_custom<T, true, true><<<blocks, nullptr, stream>>>(x1, x2, partial, y, system, info);
    } else if (ta) {
        batch_matmul_max_sum_custom<T, true, false><<<blocks, nullptr, stream>>>(x1, x2, partial, y, system, info);
    } else if (tb) {
        batch_matmul_max_sum_custom<T, false, true><<<blocks, nullptr, stream>>>(x1, x2, partial, y, system, info);
    } else {
        batch_matmul_max_sum_custom<T, false, false><<<blocks, nullptr, stream>>>(x1, x2, partial, y, system, info);
    }
}
} // namespace bmms_detail

extern "C" void run_kernel(
    GM_ADDR x1, const TensorGroupInfo &info_x1,
    GM_ADDR x2, const TensorGroupInfo &info_x2,
    GM_ADDR y, const TensorGroupInfo &info_y,
    int64_t availableCoreNum, aclrtStream stream,
    bool transposeX1, bool transposeX2)
{
    using namespace bmms_detail;
    if (info_x1.numTensors != 1 || info_x2.numTensors != 1 || info_y.numTensors != 1) {
        throw std::invalid_argument("BatchMatmulMaxSum: expected one tensor per argument");
    }
    const auto &a = info_x1.tensors[0];
    const auto &b = info_x2.tensors[0];
    const auto &c = info_y.tensors[0];
    if (a.numDims != 3 || b.numDims != 3 || c.numDims != 1 ||
        a.dtype != b.dtype || (a.dtype != 1 && a.dtype != 2) || c.dtype != 0) {
        throw std::invalid_argument("BatchMatmulMaxSum: invalid rank or dtype");
    }
    const int64_t batch = a.shape[0];
    const int64_t m = a.shape[transposeX1 ? 2 : 1];
    const int64_t k = a.shape[transposeX1 ? 1 : 2];
    const int64_t n = b.shape[transposeX2 ? 1 : 2];
    if (batch <= 0 || batch > 64 || m <= 0 || m > 8192 ||
        n <= 0 || n > 8192 || k < 32 || k > 8192 || k % 8 != 0 ||
        batch * m * k > (1LL << 26) || batch * n * k > (1LL << 26) ||
        batch != b.shape[0] || k != b.shape[transposeX2 ? 2 : 1] ||
        c.shape[0] != batch || availableCoreNum <= 0) {
        throw std::invalid_argument("BatchMatmulMaxSum: invalid dimensions");
    }

    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr || platform->GetCoreNumAic() == 0) {
        throw std::runtime_error("BatchMatmulMaxSum: platform information unavailable");
    }
    LaunchInfo info = {};
    info.batch = static_cast<int32_t>(batch);
    info.m = static_cast<int32_t>(m);
    info.n = static_cast<int32_t>(n);
    info.k = static_cast<int32_t>(k);
    info.mTiles = (info.m + TILE_M - 1) / TILE_M;
    info.nTile = ((info.n < TILE_N ? info.n : TILE_N) + 15) / 16 * 16;
    const int64_t tasks = batch * info.mTiles;
    int64_t blocks = availableCoreNum;
    if (blocks > platform->GetCoreNumAic()) blocks = platform->GetCoreNumAic();
    if (blocks > (tasks + 1) / 2) blocks = (tasks + 1) / 2;
    info.workers = static_cast<int32_t>(blocks * 2); // A2 MIX 1 AIC : 2 AIV.

    matmul_tiling::MatmulApiTiling tiling(*platform);
    const auto dtype = a.dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16
                                  : matmul_tiling::DataType::DT_BF16;
    tiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, transposeX1);
    tiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, transposeX2);
    tiling.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::NZ,
                   matmul_tiling::DataType::DT_FLOAT);
    tiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_FLOAT);
    tiling.EnableBias(false);
    tiling.SetMatmulConfigParams(0); // Norm; matches the device Matmul default.
    tiling.SetOrgShape(info.m, info.n, info.k);
    tiling.SetShape(info.m < TILE_M ? info.m : TILE_M,
                    info.n < TILE_N ? info.n : TILE_N, info.k);
    tiling.SetFixSplit(TILE_M, info.nTile, -1);
    tiling.SetBufferSpace(-1, -1, 64 * 1024);
    if (tiling.GetTiling(info.cube) == -1 || info.cube.baseM != TILE_M || info.cube.baseN != info.nTile) {
        throw std::runtime_error("BatchMatmulMaxSum: unsupported Matmul tiling");
    }

    const uint64_t partialBytes = info.mTiles == 1 ? 0 :
        (static_cast<uint64_t>(tasks) * PARTIAL_STRIDE * sizeof(float) + 511) / 512 * 512;
    const uint64_t systemBytes = platform->GetLibApiWorkSpaceSize();
    WorkspaceOwner workspace(stream);
    CheckAcl(aclrtMalloc(&workspace.address, partialBytes + systemBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    // C-style cast permits the Ascend address-space conversion.
    // reinterpret_cast between generic and __gm__ pointers is rejected.
    GM_ADDR system = (GM_ADDR)workspace.address;
    GM_ADDR partial = info.mTiles == 1 ? y : system;
    system += partialBytes;
    if (a.dtype == 1) {
        Launch<half>(x1, x2, partial, y, system, info, static_cast<uint32_t>(blocks),
                     stream, transposeX1, transposeX2);
    } else {
        Launch<bfloat16_t>(x1, x2, partial, y, system, info, static_cast<uint32_t>(blocks),
                           stream, transposeX1, transposeX2);
    }
    CheckAcl(aclrtSynchronizeStream(stream));
    CheckAcl(aclrtFree(workspace.address));
    workspace.address = nullptr;
}